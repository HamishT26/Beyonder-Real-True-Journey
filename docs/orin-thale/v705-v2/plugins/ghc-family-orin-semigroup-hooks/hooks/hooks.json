{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/advisories.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "manual_only_topics": [
    "source_fixity",
    "greens_nonpromotion",
    "ideal_collapse_boundary",
    "homomorphism_orientation",
    "opposite_nonidentity",
    "relabel_reversibility",
    "uncertainty_missingness",
    "accessible_fallback",
    "repair_nonerasure",
    "authority_hold"
  ]
}
