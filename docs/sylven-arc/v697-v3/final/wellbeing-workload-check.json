{
  "kind": "Observable workflow/load check only; no subjective wellbeing measurement",
  "working_language_only": true,
  "scope_bounded": true,
  "source_and_owner_lanes_distinct": true,
  "no_subagents_or_delegation": true,
  "temporary_preview_closed": true,
  "successful_work_not_replayed": true,
  "modular_context_selection": true,
  "memory_write": false,
  "protected_history_erased": false,
  "consciousness_or_identity_continuity_evidence": false,
  "stop_conditions": [
    "direct pause/stop/redirect/narrow/rename",
    "usage exhaustion",
    "file/word/commit ceiling",
    "missing or ambiguous exact endpoint",
    "duplicate or unresolved accepted send",
    "protected evidence/privacy/safety/authority gate"
  ]
}
