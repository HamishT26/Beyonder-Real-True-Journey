{
  "schema": "ghc.family.v641-v7.public-release-adapter-contract.v1",
  "accepted_surfaces": [
    "DESI_DR1_public_spectroscopy_metadata",
    "DESI_DR2_cosmology_supporting_product_metadata",
    "PDG_2026_constraint_catalog_metadata"
  ],
  "required_fields": [
    "authority",
    "release_id",
    "product_class",
    "source_url",
    "version_or_date",
    "license_or_access_note"
  ],
  "separation_rules": [
    "spectra_are_not_cosmology_chains",
    "release_ids_must_not_be_silently_coerced",
    "supporting_products_do_not_equal_raw_observations"
  ],
  "outputs_forbidden": [
    "likelihood",
    "parameter_estimate",
    "fit_quality",
    "gmut_confirmation",
    "new_force_detection"
  ]
}
