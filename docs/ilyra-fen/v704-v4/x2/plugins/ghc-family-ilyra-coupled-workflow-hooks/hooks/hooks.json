{
  "description": "Nonblocking constant-output checks; no payload-driven side effects.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/advisories.txt\" model_setting_change",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/advisories.txt\" model_setting_change",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking a bounded coupled-model advisory"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/advisories.txt\" source_lane_mutation",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/advisories.txt\" source_lane_mutation",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking a bounded coupled-model advisory"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/advisories.txt\" successful_replay",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/advisories.txt\" successful_replay",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking a bounded coupled-model advisory"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/advisories.txt\" rectangularity_promotion",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/advisories.txt\" rectangularity_promotion",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking a bounded coupled-model advisory"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/advisories.txt\" malformed_subject_promotion",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/advisories.txt\" malformed_subject_promotion",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking a bounded coupled-model advisory"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/advisories.txt\" broad_git_stage",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/advisories.txt\" broad_git_stage",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking a bounded coupled-model advisory"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/advisories.txt\" destructive_git",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/advisories.txt\" destructive_git",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking a bounded coupled-model advisory"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/advisories.txt\" raw_identifier_output",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/advisories.txt\" raw_identifier_output",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking a bounded coupled-model advisory"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/advisories.txt\" prepared_delivery",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/advisories.txt\" prepared_delivery",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking a bounded coupled-model advisory"
          }
        ],
        "matcher": ".*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/advisories.txt\" accepted_resend",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/advisories.txt\" accepted_resend",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking a bounded coupled-model advisory"
          }
        ]
      }
    ]
  }
}
