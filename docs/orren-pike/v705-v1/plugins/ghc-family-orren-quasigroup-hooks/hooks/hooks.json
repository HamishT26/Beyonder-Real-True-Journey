{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/advisories.txt\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "manual_only_topics": [
    "source_fixity",
    "division_orientation",
    "identity_nonpromotion",
    "associativity_falsifier",
    "isotopy_nonidentity",
    "transversal_bounds",
    "uncertainty_missingness",
    "accessible_fallback",
    "repair_nonerasure",
    "authority_hold"
  ]
}
