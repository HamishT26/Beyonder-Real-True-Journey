        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/advisories.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "manual_only_topics": [
    "truth_table_fixity",
    "anf_roundtrip",
    "spectral_nonpromotion",
    "autocorrelation_boundary",
    "affine_orbit_scope",
    "cofactor_reversibility",
    "uncertainty_missingness",
    "accessible_fallback",
    "repair_nonerasure",
    "authority_hold"
  ]
}
