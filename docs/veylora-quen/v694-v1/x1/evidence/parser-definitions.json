      "expected_error": null
    },
    {
      "id": "VQ6941-JSON-N01",
      "text": "{\"p\":2,\"p\":3}",
      "expected_error": "E_JSON_DUPLICATE"
    },
    {
      "id": "VQ6941-JSON-N02",
      "text": "{\"p\":02}",
      "expected_error": "E_JSON_SYNTAX"
    },
    {
      "id": "VQ6941-JSON-N03",
      "text": "{\"p\":NaN}",
      "expected_error": "E_JSON_SYNTAX"
    },
    {
      "id": "VQ6941-JSON-N04",
      "text": "{\"p\":1e400}",
      "expected_error": "E_JSON_NUMBER"
    },
    {
      "id": "VQ6941-JSON-N05",
      "text": " {}",
      "expected_error": "E_JSON_SYNTAX"
    },
    {
      "id": "VQ6941-JSON-N06",
      "text": "{\"a\":\"line\nbreak\"}",
      "expected_error": "E_JSON_STRING"
    },
    {
