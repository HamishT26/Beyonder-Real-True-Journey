  "mutations": [
    {
      "id": "wrong-head",
      "field": "expected_head",
      "value": "WRONG"
    },
    {
      "id": "dirty",
      "field": "clean",
      "value": false
    },
    {
      "id": "divergent",
      "field": "ahead",
      "value": 1
    },
    {
      "id": "forbidden-extension",
      "field": "allowed_extensions",
      "value": [
        "json",
        "exe"
      ]
    },
    {
      "id": "replay",
      "field": "success_replay",
      "value": true
    }
  ],
  "status": "prepared_not_executed"
}
