{
  "schema": "ghc.family.canonical-preflight.v1",
  "valid_fixture": {
    "expected_head": "FINAL_HEAD_REQUIRED",
    "clean": true,
    "ahead": 0,
    "behind": 0,
    "allowed_extensions": [
      "json",
      "md",
      "txt",
      "html"
    ],
    "outcome_labels": [
      "completed",
      "represented",
      "open_gap",
      "exact_gate"
    ],
    "canonical_invocation_limit": 1,
    "success_replay": false
